index 000000000..0661fdc32
--- /dev/null
+++ b/web/src/components/markdown-error-boundary/index.tsx
@@ -0,0 +1,56 @@
+import { ErrorBoundary } from 'react-error-boundary';
+import { Button } from '@/components/ui/button';
+import { useTranslation } from 'react-i18next';
+
+// Catches DOM reconciliation errors (e.g. removeChild NotFoundError)
+// caused by rehype-raw + streaming markdown content
+function MarkdownErrorFallback({
+  error: _error,
+  resetErrorBoundary,
+}: {
+  error: Error;
+  resetErrorBoundary: () => void;
+}) {
+  const { t } = useTranslation();
+
+  return (
+    <div className="text-sm text-text-secondary py-2 space-y-2">
+      <p>{t('chat.markdownRenderError', 'Markdown rendering error')}</p>
+      <Button variant="outline" size="sm" onClick={resetErrorBoundary}>
+        {t('common.retry', 'Retry')}
+      </Button>
+    </div>
+  );
+}
+
+interface MarkdownErrorBoundaryProps {
+  children: React.ReactNode;
+  messageId?: string;
+}
+
+// Reset the error boundary when messageId changes (new message)
+export function MarkdownErrorBoundary({
+  children,
+  messageId,
+}: MarkdownErrorBoundaryProps) {
+  return (
+    <ErrorBoundary
+      FallbackComponent={MarkdownErrorFallback}
+      resetKeys={[messageId]}
+      onError={(error) => {
+        // Only catch DOM-related errors; let others propagate
+        if (
+          error instanceof DOMException ||
+          error.name === 'NotFoundError' ||
+          error.message?.includes('removeChild')
+        ) {
+          console.warn('MarkdownErrorBoundary caught DOM error:', error.message);
+        } else {
+          console.error('MarkdownErrorBoundary caught unexpected error:', error);
+        }
+      }}
+    >
+      {children}
+    </ErrorBoundary>
+  );
+}
