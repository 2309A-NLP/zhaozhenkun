# ===================================================================
# Agent 工单10 — Docker 环境变量配置（示例）
# ===================================================================
# 复制此文件为 .env 并填入实际密钥:
#   cp .env.example .env

# === 必填: API 密钥 ===
DEEPSEEK_API_KEY=your-deepseek-key-here
QWEN_API_KEY=your-qwen-key-here

# === GPT-SoVITS 服务地址（留空=自动回退EdgeTTS） ===
GPTSOVITS_URL=

# === SadTalker 数字人模型路径（WSL2 环境） ===
SADTALKER_MODEL_PATH=/home/zzy/SadTalker_modelscope

# === 兄弟项目路径（Agent工单1-5 数据库） ===
AGENT1_PATH=/mnt/c/Users/31326/Desktop/Agent工单1
AGENT2_PATH=/mnt/c/Users/31326/Desktop/Agent工单2
AGENT3_PATH=/mnt/c/Users/31326/Desktop/Agent工单3
AGENT4_PATH=/mnt/c/Users/31326/Desktop/Agent工单4
AGENT5_PATH=/mnt/c/Users/31326/Desktop/Agent工单5

# === 金融数据集路径（基金问答 NL2SQL 依赖） ===
FINANCIAL_DATA_PATH=/mnt/c/Users/31326/bs_challenge_financial_14b_dataset

# === 日志级别 ===
LOG_LEVEL=INFO
