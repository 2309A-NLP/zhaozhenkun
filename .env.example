# ============================================================
# ADSD 多角色对话系统 — 环境变量配置示例
# 拷贝此文件为 .env 并填入真实值
# ============================================================

# Kimi API 配置（大模型对话）
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis 缓存 / 会话管理
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MySQL 持久化（可选，MYSQL_ENABLED=false 可关闭）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_chat_system
MYSQL_ENABLED=true

# BGE 嵌入模型路径（默认：项目根目录下的 models/ 目录）
# BGE_M3_PATH=models/bge-m3
# BGE_RERANKER_PATH=models/bge-reranker-base

# 应用配置
SECRET_KEY=rag_chat_secret_key_2024
SESSION_TIMEOUT=604800
