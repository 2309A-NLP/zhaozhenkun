09:16:49 [INFO] agent.tools: 基金SQL: SELECT 
    a."股票代码",
    ROUND((a."收盘价(元)" - a."昨收盘(元)") / a."昨收盘(元)" * 100, 2) AS 涨跌幅
FROM 
    "A股票日行情表" a
INNER JOIN 
    "A股公司行业划分表" i 
    ON a."股票代码" = i."股票代码" 
    AND a."交易日" = i."交易日期"
WHER
